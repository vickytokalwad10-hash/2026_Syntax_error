# AgriPulse AI Configuration Template

# Google Gemini API Key for Domain-Restricted Chatbot
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Connection URI (Motor Async Driver)
MONGO_URI=mongodb://localhost:27017/agripulse_ai

# JWT Authentication Secret Key & Expiration (Hours)
JWT_SECRET=agripulse_super_secret_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=72

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY=rzp_test_agripulse2026
RAZORPAY_SECRET=rzp_secret_agripulse_sandbox_key

# SMS / Phone OTP Provider Key (e.g. Twilio / Fast2SMS / Sandbox)
OTP_PROVIDER_KEY=mock_otp_sandbox_key_2026

# Server Port and Host
PORT=8000
HOST=0.0.0.0
