# AgriPulse AI Backend Environment Configuration
# Add your Google Gemini API key here
GEMINI_API_KEY=

# data.gov.in Open Government Data (OGD) Agmarknet & e-NAM Daily Mandi Prices
# Register free at https://data.gov.in to generate your API key
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_IN_ENAM_RESOURCE_ID=

# MongoDB / Supabase Configuration
MONGO_URI=mongodb://localhost:27017/agripulse_ai
