# AgriPulse AI Backend Environment Configuration
# Add your Google Gemini API key here
GEMINI_API_KEY=

# MongoDB / Supabase Configuration
MONGO_URI=mongodb://localhost:27017/agripulse_ai
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=72

# Payment Rails & Notifications
RAZORPAY_KEY=rzp_test_your_key
RAZORPAY_SECRET=rzp_secret_your_key
OTP_PROVIDER_KEY=mock_otp_sandbox_key_2026

# Server Network Configuration
PORT=8000
HOST=0.0.0.0
